<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Simple cylinder inertia helper -->
  <xacro:macro name="cyl_inertial" params="m r h *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" iyy="${m*(3*r*r+h*h)/12}"
               izz="${m*r*r/2}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertial" params="m x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}"
               izz="${m*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="kobuki_base">

    <!-- base_footprint: ground projection; base_link co-located at ground
         level under the base center so all z values read as height AGL -->
    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
      <visual>
        <origin xyz="0 0 ${(base_body_z0+base_body_top)/2}"/>
        <geometry><cylinder radius="${base_radius}" length="${base_body_top-base_body_z0}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <!-- red bumper ring, cosmetic kobuki look -->
      <visual>
        <origin xyz="0 0 ${base_body_z0+0.02}"/>
        <geometry><cylinder radius="${base_radius+0.002}" length="0.03"/></geometry>
        <material name="red_accent"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${(base_body_z0+base_body_top)/2}"/>
        <geometry><cylinder radius="${base_radius}" length="${base_body_top-base_body_z0}"/></geometry>
      </collision>
      <xacro:cyl_inertial m="3.2" r="${base_radius}" h="${base_body_top-base_body_z0}">
        <origin xyz="0 0 ${(base_body_z0+base_body_top)/2}"/>
      </xacro:cyl_inertial>
    </link>

    <!-- arm mounting deck (hex on the real robot, cylinder here) -->
    <link name="deck_link">
      <visual>
        <origin xyz="0 0 -0.005"/>
        <geometry><cylinder radius="${base_radius}" length="0.01"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.005"/>
        <geometry><cylinder radius="${base_radius}" length="0.01"/></geometry>
      </collision>
      <xacro:cyl_inertial m="0.4" r="${base_radius}" h="0.01">
        <origin xyz="0 0 -0.005"/>
      </xacro:cyl_inertial>
    </link>
    <joint name="deck_joint" type="fixed">
      <parent link="base_link"/>
      <child link="deck_link"/>
      <origin xyz="0 0 ${deck_top_z}"/>
    </joint>

    <!-- drive wheels -->
    <xacro:macro name="drive_wheel" params="prefix reflect">
      <link name="${prefix}_wheel_link">
        <visual>
          <origin rpy="${-PI/2} 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
          <material name="black"/>
        </visual>
        <collision>
          <origin rpy="${-PI/2} 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <inertial>
          <mass value="0.12"/>
          <inertia ixx="6e-5" iyy="6e-5" izz="9e-5" ixy="0" ixz="0" iyz="0"/>
        </inertial>
      </link>
      <joint name="${prefix}_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="${prefix}_wheel_link"/>
        <origin xyz="0 ${reflect*wheel_sep/2} ${wheel_radius}"/>
        <axis xyz="0 1 0"/>
      </joint>
      <gazebo reference="${prefix}_wheel_link">
        <mu1>1.0</mu1><mu2>1.0</mu2>
      </gazebo>
    </xacro:macro>
    <xacro:drive_wheel prefix="left"  reflect="1"/>
    <xacro:drive_wheel prefix="right" reflect="-1"/>

    <!-- front / rear casters: frictionless spheres -->
    <xacro:macro name="caster" params="prefix x">
      <link name="${prefix}_caster_link">
        <visual>
          <geometry><sphere radius="${caster_radius}"/></geometry>
          <material name="light_grey"/>
        </visual>
        <collision>
          <geometry><sphere radius="${caster_radius}"/></geometry>
        </collision>
        <inertial>
          <mass value="0.02"/>
          <inertia ixx="3e-6" iyy="3e-6" izz="3e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
      </link>
      <joint name="${prefix}_caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="${prefix}_caster_link"/>
        <origin xyz="${x} 0 ${caster_radius}"/>
      </joint>
      <gazebo reference="${prefix}_caster_link">
        <mu1>0.0</mu1><mu2>0.0</mu2>
      </gazebo>
    </xacro:macro>
    <xacro:caster prefix="front" x="0.15"/>
    <xacro:caster prefix="rear"  x="-0.15"/>

  </xacro:macro>
</robot>
