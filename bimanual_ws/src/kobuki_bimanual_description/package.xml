<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kobuki_bimanual_description</name>
  <version>0.1.0</version>
  <description>
    URDF/Xacro description of a Kobuki-class mobile base with two 4-DOF arms,
    parallel-jaw grippers, sensor mast (RGB camera + 2D LiDAR), ros2_control
    interfaces and Gazebo Harmonic plugins.
  </description>
  <maintainer email="nishrraj@todo.todo">nishrraj</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
