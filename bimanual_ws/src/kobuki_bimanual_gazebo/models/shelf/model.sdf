<?xml version="1.0"?>
<sdf version="1.9">
  <model name="shelf">
    <static>true</static>
    <link name="link">
      <!-- top slab: 0.25 (x, depth) x 0.40 (y, width), top surface at z=0.12 -->
      <collision name="slab_col">
        <pose>0 0 0.11 0 0 0</pose>
        <geometry><box><size>0.25 0.40 0.02</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="slab_vis">
        <pose>0 0 0.11 0 0 0</pose>
        <geometry><box><size>0.25 0.40 0.02</size></box></geometry>
        <material><ambient>0.72 0.72 0.70 1</ambient><diffuse>0.72 0.72 0.70 1</diffuse></material>
      </visual>

      <!-- legs -->
      <collision name="leg1_col"><pose>0.105 0.18 0.05 0 0 0</pose><geometry><box><size>0.03 0.03 0.10</size></box></geometry></collision>
      <visual name="leg1_vis"><pose>0.105 0.18 0.05 0 0 0</pose><geometry><box><size>0.03 0.03 0.10</size></box></geometry><material><ambient>0.45 0.45 0.44 1</ambient><diffuse>0.45 0.45 0.44 1</diffuse></material></visual>
      <collision name="leg2_col"><pose>0.105 -0.18 0.05 0 0 0</pose><geometry><box><size>0.03 0.03 0.10</size></box></geometry></collision>
      <visual name="leg2_vis"><pose>0.105 -0.18 0.05 0 0 0</pose><geometry><box><size>0.03 0.03 0.10</size></box></geometry><material><ambient>0.45 0.45 0.44 1</ambient><diffuse>0.45 0.45 0.44 1</diffuse></material></visual>
      <collision name="leg3_col"><pose>-0.105 0.18 0.05 0 0 0</pose><geometry><box><size>0.03 0.03 0.10</size></box></geometry></collision>
      <visual name="leg3_vis"><pose>-0.105 0.18 0.05 0 0 0</pose><geometry><box><size>0.03 0.03 0.10</size></box></geometry><material><ambient>0.45 0.45 0.44 1</ambient><diffuse>0.45 0.45 0.44 1</diffuse></material></visual>
      <collision name="leg4_col"><pose>-0.105 -0.18 0.05 0 0 0</pose><geometry><box><size>0.03 0.03 0.10</size></box></geometry></collision>
      <visual name="leg4_vis"><pose>-0.105 -0.18 0.05 0 0 0</pose><geometry><box><size>0.03 0.03 0.10</size></box></geometry><material><ambient>0.45 0.45 0.44 1</ambient><diffuse>0.45 0.45 0.44 1</diffuse></material></visual>

      <!-- tall back board (rear = -x side): LiDAR landmark -->
      <collision name="back_col">
        <pose>-0.135 0 0.30 0 0 0</pose>
        <geometry><box><size>0.02 0.40 0.60</size></box></geometry>
      </collision>
      <visual name="back_vis">
        <pose>-0.135 0 0.30 0 0 0</pose>
        <geometry><box><size>0.02 0.40 0.60</size></box></geometry>
        <material><ambient>0.58 0.58 0.56 1</ambient><diffuse>0.58 0.58 0.56 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
