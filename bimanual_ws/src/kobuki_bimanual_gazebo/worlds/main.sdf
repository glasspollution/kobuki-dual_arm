<?xml version="1.0"?>
<sdf version="1.9">
  <world name="bimanual_main">

    <physics name="step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 6 x 6 m room -->
    <model name="wall_xp"><static>true</static><pose>3.05 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 6.2 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 6.2 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_xn"><static>true</static><pose>-3.05 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 6.2 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 6.2 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_yp"><static>true</static><pose>0 3.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.2 0.1 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>6.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_yn"><static>true</static><pose>0 -3.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.2 0.1 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>6.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>
      </link>
    </model>

    <!-- shelf behind the robot spawn point, front face toward +x -->
    <include>
      <uri>model://shelf</uri>
      <name>shelf</name>
      <pose>-1.2 0 0 0 0 0</pose>
    </include>

    <!-- fallen objects: each lying with its long axis pointing back at the
         robot spawn area (robot spawns at origin, facing +x) -->
    <include>
      <uri>model://bottle</uri>
      <name>bottle</name>
      <pose>1.6 0 0.031 0 1.5708 0</pose>
    </include>
    <include>
      <uri>model://bowl</uri>
      <name>bowl</name>
      <pose>1.3 -1.0 0.041 0 1.5708 -0.6557</pose>
    </include>
    <include>
      <uri>model://cracker_box</uri>
      <name>cracker_box</name>
      <pose>1.2 1.1 0.031 0 1.5708 0.7419</pose>
    </include>

  </world>
</sdf>
